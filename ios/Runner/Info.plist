<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Smart Rent</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Smart Rent</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <!-- UIScene lifecycle — required by iOS 26 SDK (Xcode 26). Without this
         the app crashes immediately on launch with a missing scene manifest error. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
      <key>UIApplicationSupportsMultipleScenes</key>
      <false/>
      <key>UISceneConfigurations</key>
      <dict>
        <key>UIWindowSceneSessionRoleApplication</key>
        <array>
          <dict>
            <key>UISceneClassName</key>
            <string>UIWindowScene</string>
            <key>UISceneConfigurationName</key>
            <string>flutter</string>
            <key>UISceneDelegateClassName</key>
            <string>FlutterSceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
          </dict>
        </array>
      </dict>
    </dict>

    <!-- Orientations: Portrait only for iPhone (rental app), all for iPad -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
      <string>UIInterfaceOrientationPortraitUpsideDown</string>
      <string>UIInterfaceOrientationLandscapeLeft</string>
      <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Performance -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!-- ============================================================ -->
    <!-- PERMISSION USAGE DESCRIPTIONS — Apple Guideline 5.1.1        -->
    <!-- Every key below maps to an actual feature in the app.        -->
    <!-- ============================================================ -->

    <!-- Camera: profile photo & KYC identity documents -->
    <key>NSCameraUsageDescription</key>
    <string>نستخدم الكاميرا لالتقاط صورة ملفك الشخصي وتصوير الهوية ورخصة القيادة لتوثيق حسابك.</string>

    <!-- Photo Library read: upload profile photo & identity documents -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>نستخدم الصور لرفع صورة ملفك الشخصي ووثائق التحقق (الهوية ورخصة القيادة).</string>

    <!-- Location (when in use only): nearby vehicles, branch pickup & delivery check -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>نستخدم موقعك لعرض أقرب السيارات والفروع إليك، وللتحقق من توفر خدمة التوصيل وحساب رسومها.</string>

    <!-- Location (always & when in use): required by Google Maps SDK CoreLocation references -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>نستخدم موقعك لعرض أقرب السيارات والفروع إليك، وللتحقق من توفر خدمة التوصيل وحساب رسومها.</string>

    <!-- Google Maps iOS SDK API key (read from Info.plist at runtime) -->
    <key>GMSApiKey</key>
    <string>AIzaSyDBtOCLLOaWvNjc5WPOQjBbHkSGSy3Y-9k</string>

    <!-- Background Modes: remote-notification for Firebase Cloud Messaging -->
    <key>UIBackgroundModes</key>
    <array>
      <string>remote-notification</string>
    </array>

    <!-- Firebase method swizzling — must be YES when using firebase_messaging -->
    <key>FirebaseAppDelegateProxyEnabled</key>
    <true/>

    <!-- App Store Export Compliance: app uses standard HTTPS/TLS encryption only -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- Schemes queried by url_launcher (tel, mailto, https, http) -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
      <string>tel</string>
      <string>mailto</string>
      <string>https</string>
      <string>http</string>
    </array>

  </dict>
</plist>